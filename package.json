{
  "name": "@haskou/metrics",
  "version": "1.2.0",
  "description": "Framework-agnostic metrics instrumentation for TypeScript with explicit ports, functions, and decorators.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/index.node.d.ts",
          "default": "./dist/index.node.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "node": {
        "import": {
          "types": "./dist/testing/index.node.d.ts",
          "default": "./dist/testing/index.node.js"
        },
        "require": {
          "types": "./dist/testing/index.d.cts",
          "default": "./dist/testing/index.cjs"
        }
      },
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./adapters/console": {
      "node": {
        "import": {
          "types": "./dist/adapters/console/index.node.d.ts",
          "default": "./dist/adapters/console/index.node.js"
        },
        "require": {
          "types": "./dist/adapters/console/index.d.cts",
          "default": "./dist/adapters/console/index.cjs"
        }
      },
      "import": {
        "types": "./dist/adapters/console/index.d.ts",
        "default": "./dist/adapters/console/index.js"
      },
      "require": {
        "types": "./dist/adapters/console/index.d.cts",
        "default": "./dist/adapters/console/index.cjs"
      }
    },
    "./adapters/node": {
      "node": {
        "import": {
          "types": "./dist/adapters/node/index.node.d.ts",
          "default": "./dist/adapters/node/index.node.js"
        },
        "require": {
          "types": "./dist/adapters/node/index.d.cts",
          "default": "./dist/adapters/node/index.cjs"
        }
      },
      "import": {
        "types": "./dist/adapters/node/index.d.ts",
        "default": "./dist/adapters/node/index.js"
      },
      "require": {
        "types": "./dist/adapters/node/index.d.cts",
        "default": "./dist/adapters/node/index.cjs"
      }
    },
    "./adapters/prometheus": {
      "node": {
        "import": {
          "types": "./dist/adapters/prometheus/index.node.d.ts",
          "default": "./dist/adapters/prometheus/index.node.js"
        },
        "require": {
          "types": "./dist/adapters/prometheus/index.d.cts",
          "default": "./dist/adapters/prometheus/index.cjs"
        }
      },
      "import": {
        "types": "./dist/adapters/prometheus/index.d.ts",
        "default": "./dist/adapters/prometheus/index.js"
      },
      "require": {
        "types": "./dist/adapters/prometheus/index.d.cts",
        "default": "./dist/adapters/prometheus/index.cjs"
      }
    },
    "./contracts": {
      "node": {
        "import": {
          "types": "./dist/contracts/index.node.d.ts",
          "default": "./dist/contracts/index.node.js"
        },
        "require": {
          "types": "./dist/contracts/index.d.cts",
          "default": "./dist/contracts/index.cjs"
        }
      },
      "import": {
        "types": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/index.js"
      },
      "require": {
        "types": "./dist/contracts/index.d.cts",
        "default": "./dist/contracts/index.cjs"
      }
    },
    "./configuration": {
      "node": {
        "import": {
          "types": "./dist/configuration/index.node.d.ts",
          "default": "./dist/configuration/index.node.js"
        },
        "require": {
          "types": "./dist/configuration/index.d.cts",
          "default": "./dist/configuration/index.cjs"
        }
      },
      "import": {
        "types": "./dist/configuration/index.d.ts",
        "default": "./dist/configuration/index.js"
      },
      "require": {
        "types": "./dist/configuration/index.d.cts",
        "default": "./dist/configuration/index.cjs"
      }
    },
    "./instrumentation": {
      "node": {
        "import": {
          "types": "./dist/instrumentation/index.node.d.ts",
          "default": "./dist/instrumentation/index.node.js"
        },
        "require": {
          "types": "./dist/instrumentation/index.d.cts",
          "default": "./dist/instrumentation/index.cjs"
        }
      },
      "import": {
        "types": "./dist/instrumentation/index.d.ts",
        "default": "./dist/instrumentation/index.js"
      },
      "require": {
        "types": "./dist/instrumentation/index.d.cts",
        "default": "./dist/instrumentation/index.cjs"
      }
    },
    "./model": {
      "node": {
        "import": {
          "types": "./dist/model/index.node.d.ts",
          "default": "./dist/model/index.node.js"
        },
        "require": {
          "types": "./dist/model/index.d.cts",
          "default": "./dist/model/index.cjs"
        }
      },
      "import": {
        "types": "./dist/model/index.d.ts",
        "default": "./dist/model/index.js"
      },
      "require": {
        "types": "./dist/model/index.d.cts",
        "default": "./dist/model/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "metrics",
    "instrumentation",
    "observability",
    "decorators",
    "typescript",
    "framework-agnostic",
    "cpu-metrics",
    "memory-metrics",
    "structured-logging",
    "stack-traces"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haskou/metrics.git"
  },
  "bugs": {
    "url": "https://github.com/haskou/metrics/issues"
  },
  "homepage": "https://haskou.github.io/metrics/",
  "scripts": {
    "build": "tsup && node scripts/build-node-wrappers.mjs",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ./src ./tests --ext .ts --ignore-pattern tests/typescript/** --no-warn-ignored",
    "lint:fix": "eslint ./src ./tests --ext .ts --ignore-pattern tests/typescript/** --no-warn-ignored --fix",
    "pages:build": "yarn docs:build && yarn playground:build && node scripts/compose-pages.mjs",
    "playground:build": "tsc -p playground/tsconfig.json && vite build playground",
    "playground:dev": "vite playground",
    "pack:dry": "npm pack --dry-run",
    "prepack": "yarn build",
    "test": "yarn build && yarn test:typecheck && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "yarn build && yarn test:typecheck && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:package": "yarn build && node scripts/verify-package.mjs",
    "test:typecheck": "tsc -p tests/tsconfig.json && tsc -p tests/typescript/tsconfig.json && tsc -p tests/typescript-standard/tsconfig.json && tsc -p tests/compatibility/tsconfig.json && tsc -p tests/compatibility/tsconfig.browser.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "yarn build && node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@haskou/value-objects": "^7.0.3"
  },
  "peerDependencies": {
    "prom-client": "^15.1.3"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@haskou/eslint-config": "^0.2.2",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.7",
    "prom-client": "^15.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": "",
  "imports": {
    "#resource-usage": {
      "node": "./dist/adapters/node/defaultResourceUsage.cjs",
      "default": "./dist/adapters/system/defaultResourceUsage.js"
    }
  }
}
